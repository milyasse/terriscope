# Copier en .env pour le développement. Ne jamais committer de vraie valeur.
# Mode de données de l'application web : demo (seul mode disponible pour l'instant)
VITE_DATA_MODE=demo
# Chemin de base du site, utilisé par la publication GitHub Pages
VITE_BASE_PATH=./

# API (apps/api). Le rôle de connexion doit posséder le schéma et être membre de terriscope_app.
DATABASE_URL=postgres://terriscope:CHANGER_MOI@localhost:5432/terriscope
PORT=3000
# Origines autorisées à appeler l'API, séparées par des virgules
CORS_ORIGINS=http://localhost:5173
# Durée de vie d'une session, en heures
SESSION_TTL_HOURS=168
# Moteur de routage. Sans cette variable, les isochrones répondent « non disponible ».
VALHALLA_URL=
POSTGRES_PASSWORD=CHANGER_MOI
